<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sign_ngsign_js" model="ir.actions.client">
        <field name="name">Sign with NGSign</field>
        <field name="tag">ngsign_einvoice_odoo.action_sign_ngsign_js</field>
    </record>

    <record id="view_move_form_inherit_ngsign" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ngsign</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ngsign_show_debug_json_button" invisible="1"/>
                <field name="ngsign_show_transaction_uuid" invisible="1"/>
                <field name="ngsign_show_invoice_uuid" invisible="1"/>
                <field name="ngsign_pds_url" invisible="1"/>
                <field name="ngsign_certificate_type" invisible="1"/>
                
                <!-- Button for SEAL certificate type -->
                <button name="ngsign_einvoice_odoo.action_sign_ngsign_js" string="Sign with NGSign" type="action" class="oe_highlight"
                        invisible="ngsign_certificate_type in ('digigo', 'sscd') or state != 'posted' or ngsign_status in ('pending', 'pending_signature', 'signed', 'TTN Signed', 'signed_ngsign')"/>
                
                <!-- Button for DigiGO / SSCD certificate types (Opens Wizard) -->
                <button name="%(ngsign_einvoice_odoo.action_ngsign_sign_options_wizard)d" string="Sign with NGSign" type="action" class="oe_highlight"
                        invisible="ngsign_certificate_type == 'seal' or state != 'posted' or ngsign_status in ('pending', 'pending_signature', 'signed', 'TTN Signed', 'signed_ngsign')"/>
                        
                <button name="%(ngsign_einvoice_odoo.action_ngsign_pds_options_wizard)d" string="Signing Page" type="action" class="oe_highlight"
                        invisible="not ngsign_pds_url or ngsign_status != 'pending_signature'"
                        help="Open the Page de Signature or send it via email"/>
                <button name="action_check_ngsign_status" string="Check NGSign Status" type="object"
                        invisible="ngsign_status in ('draft', 'CANCELLED', 'TTN Signed')"/>
                <button name="action_delete_test_transaction" string="Delete eInvoice Test" type="object"
                        invisible="ngsign_ttn_mode == 'prod' or ngsign_status == 'draft'"
                        confirm="Are you sure you want to delete this test transaction? This will remove all NGSign data and signed files."/>
                <button name="action_generate_debug_json" string="Generate Debug JSON" type="object"
                        invisible="not ngsign_show_debug_json_button"/>
                <button name="action_ngsign_check_data" string="Check e-Invoice Data" type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund') or ngsign_status in ('pending', 'pending_signature', 'TTN Signed', 'signed_ngsign')"
                        help="Check the data that will be sent to NGSign / TTN and list what has to be corrected"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div invisible="not ngsign_validation_message">
                    <field name="ngsign_validation_message" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="eInvoice Info" name="einvoice_info">
                    <group>
                        <group>
                            <field name="ngsign_transaction_uuid" readonly="1" invisible="not ngsign_show_transaction_uuid"/>
                            <field name="ngsign_invoice_uuid" readonly="1" invisible="not ngsign_show_invoice_uuid"/>
                            <field name="ngsign_ttn_reference" readonly="1"/>
                            <field name="ngsign_ttn_qr_code" widget="image" readonly="1" invisible="not ngsign_ttn_qr_code"/>
                        </group>
                        <group>
                            <field name="ngsign_status" readonly="1"/>
                            <field name="ngsign_notify_owner" readonly="ngsign_status != 'draft'"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


    <record id="view_invoice_tree_inherit_ngsign" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit.ngsign</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="ngsign_status" optional="show" widget="badge"
                       decoration-success="ngsign_status == 'TTN Signed'"
                       decoration-info="ngsign_status == 'signed_ngsign'"
                       decoration-warning="ngsign_status in ('pending', 'pending_signature')"
                       decoration-danger="ngsign_status in ('error', 'TTN_REJECTED', 'CANCELLED')"/>
            </field>
        </field>
    </record>
    <record id="action_sign_ngsign_bulk" model="ir.actions.server">
        <field name="name">Sign with NGSign</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.client',
    'tag': 'ngsign_einvoice_odoo.action_sign_ngsign_js',
    'context': {'active_ids': records.ids},
}
        </field>
    </record>

    <record id="action_generate_debug_json_bulk" model="ir.actions.server">
        <field name="name">Generate Debug JSON</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_generate_debug_json()
        </field>
    </record>
</odoo>
