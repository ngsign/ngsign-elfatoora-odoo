msgstr "Code taxe TEIF"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "TTN accepts 20 characters at most: use the RIB (20 digits) rather than the IBAN, and remove spaces."
msgstr "TTN accepte 20 caractères au maximum : utilisez le RIB (20 chiffres) plutôt que l'IBAN, et supprimez les espaces."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "Tax ID (Matricule Fiscal)"
msgstr "Matricule fiscal"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "Tax code"
msgstr "Code de taxe"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "Tax rate"
msgstr "Taux de taxe"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The Tax ID (Matricule Fiscal) of the company \"%(company)s\" is not set."
msgstr "Le matricule fiscal de la société « %(company)s » n'est pas renseigné."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The Tax ID of the company \"%(company)s\" (\"%(value)s\") contains characters other than letters and digits."
msgstr "Le matricule fiscal de la société « %(company)s » (« %(value)s ») contient des caractères autres que des lettres et des chiffres."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The Tax ID of the company \"%(company)s\" (\"%(value)s\") does not look like a Matricule Fiscal: 7 digits followed by a key letter are expected (e.g. 1234567A or 1234567AAM000)."
msgstr "Le matricule fiscal de la société « %(company)s » (« %(value)s ») ne ressemble pas à un matricule fiscal : 7 chiffres suivis d'une lettre clé sont attendus (par ex. 1234567A ou 1234567AAM000)."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The Tax ID of the contact \"%(contact)s\" (\"%(contact_vat)s\") differs from the one of its company \"%(company)s\" (\"%(company_vat)s\"). The contact's one is sent."
msgstr "Le matricule fiscal du contact « %(contact)s » (« %(contact_vat)s ») diffère de celui de sa société « %(company)s » (« %(company_vat)s »). C'est celui du contact qui est envoyé."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The bank account \"%(acc)s\" is not linked to a bank; \"Bank\" would be sent as the institution name."
msgstr "Le compte bancaire « %(acc)s » n'est rattaché à aucune banque ; « Bank » serait envoyé comme nom de l'institution."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "The currency code must be an ISO 4217 code such as TND."
msgstr "Le code devise doit être un code ISO 4217 tel que TND."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The description is %(len)s characters long: only the first 500 will be sent to TTN."
msgstr "La description comporte %(len)s caractères : seuls les 500 premiers seront envoyés à TTN."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The description spans several lines: only the first line (\"%(first)s\") will be sent to TTN."
msgstr "La description s'étend sur plusieurs lignes : seule la première ligne (« %(first)s ») sera envoyée à TTN."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The e-invoice data could not be generated: %s"
msgstr "Les données de la facture électronique n'ont pas pu être générées : %s"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "The full address of the customer (street, zip, city, country) is required."
msgstr "L'adresse complète du client (rue, code postal, ville, pays) est obligatoire."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The invoice date is not set; today's date would be sent instead."
msgstr "La date de facturation n'est pas renseignée ; la date du jour serait envoyée à la place."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "The invoice must contain at least one product line (sections and notes are not sent)."
msgstr "La facture doit contenir au moins une ligne d'article (les sections et les notes ne sont pas envoyées)."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The invoice note contains HTML formatting; the tags are sent as-is in the e-invoice comments."
msgstr "La note de facture contient de la mise en forme HTML ; les balises sont envoyées telles quelles dans les commentaires de la facture électronique."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The line carries %(count)s VAT taxes; only \"%(kept)s\" will be sent as the line VAT rate, the others as additional taxes."
msgstr "La ligne porte %(count)s taxes de TVA ; seule « %(kept)s » sera envoyée comme taux de TVA de la ligne, les autres comme taxes supplémentaires."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The payment term \"%(term)s\" has no TEIF condition code; \"I-121\" (immediate payment) would be sent instead."
msgstr "La condition de paiement « %(term)s » n'a pas de code condition TEIF ; « I-121 » (paiement immédiat) serait envoyé à la place."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The payment term \"%(term)s\" uses the code %(code)s, which the current NGSign schema does not list (I-121 to I-124). It may be rejected by TTN."
msgstr "La condition de paiement « %(term)s » utilise le code %(code)s, qui ne figure pas dans le schéma NGSign actuel (I-121 à I-124). Il peut être rejeté par TTN."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The product has no internal reference: \"N/A\" will be sent as the item code."
msgstr "L'article n'a pas de référence interne : « N/A » sera envoyé comme code article."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The sum of the e-invoice lines (%(lines)s) differs from the invoice total excluding tax (%(total)s). TTN may reject the invoice."
msgstr "La somme des lignes de la facture électronique (%(lines)s) diffère du total hors taxes de la facture (%(total)s). TTN peut rejeter la facture."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The tax \"%(tax)s\" has no TEIF code; it would be sent as \"I-1606\" (other tax)."
msgstr "La taxe « %(tax)s » n'a pas de code TEIF ; elle serait envoyée comme « I-1606 » (autre taxe)."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The tax \"%(tax)s\" uses the code %(code)s, which the current NGSign schema does not list (only I-1601 to I-1603 and I-160 to I-169 are documented). It may be rejected by TTN."
msgstr "La taxe « %(tax)s » utilise le code %(code)s, qui ne figure pas dans le schéma NGSign actuel (seuls I-1601 à I-1603 et I-160 à I-169 sont documentés). Il peut être rejeté par TTN."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "The unit of measure \"%(uom)s\" is longer than 8 characters and will be shortened to \"%(sent)s\"."
msgstr "L'unité de mesure « %(uom)s » dépasse 8 caractères et sera raccourcie en « %(sent)s »."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "This usually comes from global discounts or from lines excluded from the e-invoice."
msgstr "Cela vient généralement des remises globales ou de lignes exclues de la facture électronique."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "Total amount in letters"
msgstr "Montant total en lettres"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "Total excluding tax"
msgstr "Total hors taxes"

