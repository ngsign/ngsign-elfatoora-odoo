#. module: ngsign_einvoice_odoo
#: model:mail.template,body_html:ngsign_einvoice_odoo.email_template_ngsign_signature_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hello <t t-out=\"ctx.get('ngsign_send_to_user_name') or 'User'\"/>,\n"
"                        <br/><br/>\n"
"                        You have been requested to sign the eInvoice <strong><t t-out=\"object.name\"/></strong>.\n"
"                        <br/><br/>\n"
"                        Please click the button below to access the NGSign Page de Signature (PDS) and complete the signing process using your DigiGO or SSCD certificate.\n"
"                        <br/><br/>\n"
"                        </p><div style=\"margin: 16px 0px 16px 0px;\">\n"
"                            <a t-att-href=\"ctx.get('ngsign_pds_url')\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"                                Sign eInvoice\n"
"                            </a>\n"
"                        </div>\n"
"                        <br/><br/>\n"
"                        If the button doesn't work, you can copy and paste this URL into your browser:\n"
"                        <br/>\n"
"                        <t t-out=\"ctx.get('ngsign_pds_url')\"/>\n"
"                        <br/><br/>\n"
"                        Thank you,\n"
"                        <br/>\n"
"                        <t t-out=\"user.signature or ''\"/>\n"
"                    \n"
"                </div>\n"
"            "
msgstr ""

