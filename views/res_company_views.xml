<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ngsign" model="ir.ui.view">
        <field name="name">res.company.form.ngsign</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div invisible="not ngsign_validation_message">
                    <field name="ngsign_validation_message" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
