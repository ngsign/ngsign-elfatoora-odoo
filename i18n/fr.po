#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "Unit of measure"
msgstr "Unité de mesure"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_spec.py:0
msgid "Unit price"
msgstr "Prix unitaire"

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "Use plain text in the 'Terms and conditions' field."
msgstr "Utilisez du texte brut dans le champ « Conditions générales »."

#. module: ngsign_einvoice_odoo
#. odoo-python
#: code:addons/ngsign_einvoice_odoo/models/ngsign_validator.py:0
msgid "VAT"
msgstr "TVA"

